+};
+/* Intersect the query ray with triangle lists and alternating triangle strips. */
 void fn_1_4A24(ChallengeCollisionQuery* query, struct ChallengeCollisionMesh* mesh) {
-    return;
+    Vec points[3];
+    Vec vectors[3];
+    for (;;) {
+        u32 count = mesh->count;
+
+        u8 strip;
+        if (!count) break;
+        strip = mesh->strip;
+        mesh = (struct ChallengeCollisionMesh*)mesh->vertices;
+        if (!strip) {
+            do {
+                PSMTXMultVec(query->view, &((ChallengeCollisionVertex*)mesh)[0].position, &points[0]);
+                PSMTXMultVec(query->view, &((ChallengeCollisionVertex*)mesh)[1].position, &points[1]);
+                PSMTXMultVec(query->view, &((ChallengeCollisionVertex*)mesh)[2].position, &points[2]);
