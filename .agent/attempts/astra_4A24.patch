+                inside &= (points[1].x * points[2].y - points[2].x * points[1].y) >= 0;
+                inside &= (points[2].x * points[0].y - points[0].x * points[2].y) >= 0;
+                if (inside) {
+                    f32 distance;
+
+                    PSVECSubtract(&points[1], &points[0], &vectors[0]);
+                    PSVECSubtract(&points[2], &points[1], &vectors[1]);
+                    PSVECCrossProduct(&vectors[0], &vectors[1], &vectors[2]);
+                    distance = -PSVECDotProduct(&vectors[2], &points[0]) / vectors[2].z;
+                    if (distance >= 0 && query->nearest > distance) {
+                        query->nearest = distance;
+                        query->hits = ((ChallengeCollisionVertex*)mesh)[2].id;
+                        query->normal = vectors[2];
+                    }
+                }
+                }
+                mesh = (struct ChallengeCollisionMesh*)((ChallengeCollisionVertex*)mesh + 3);
+            } while (--count);
