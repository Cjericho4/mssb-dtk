+            u32 reverse = 0;
+            PSMTXMultVec(query->view, &((ChallengeCollisionVertex*)mesh)[0].position, &points[0]);
+            PSMTXMultVec(query->view, &((ChallengeCollisionVertex*)mesh)[1].position, &points[1]);
+            mesh = (struct ChallengeCollisionMesh*)((ChallengeCollisionVertex*)mesh + 2);
+            do {
+                u32 inside;
+                PSMTXMultVec(query->view, &((ChallengeCollisionVertex*)mesh)->position, &points[2]);
+                vectors[0].z = points[2].x * points[0].y - points[0].x * points[2].y;
+                vectors[0].y = points[1].x * points[2].y - points[2].x * points[1].y;
+                vectors[0].x = points[0].x * points[1].y - points[1].x * points[0].y;
+                if (reverse) inside = (vectors[0].z <= 0) & ((vectors[0].x <= 0) & (vectors[0].y <= 0));
+                else inside = (vectors[0].z >= 0) & ((vectors[0].x >= 0) & (vectors[0].y >= 0));
+                if (inside) {
+                    f32 distance;
+
+                    PSVECSubtract(&points[1], &points[0], &vectors[0]);
+                    PSVECSubtract(&points[2], &points[1], &vectors[1]);
+                    PSVECCrossProduct(&vectors[0], &vectors[1], &vectors[2]);
+                    distance = -PSVECDotProduct(&vectors[2], &points[0]) / vectors[2].z;
+                    if (distance >= 0 && query->nearest > distance) {
+                        query->nearest = distance;
+                        query->hits = ((ChallengeCollisionVertex*)mesh)->id;
+                        if (!reverse) query->normal = vectors[2];
+                        else {
+                            query->normal.x = -vectors[2].x;
+                            query->normal.y = -vectors[2].y;
+                            query->normal.z = -vectors[2].z;
+                        }
+                    }
+                }
