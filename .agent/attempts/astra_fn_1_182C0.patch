+}
+/* Draw the rotated preview rectangle with independent front and back colors. */
+void fn_1_182C0(ChallengeQuadPreview* preview) {
+    ControlExt control;
+    Vec vertices[4];
+    Mtx transform;
+    Mtx44 projection;
+    f32 halfWidth = preview->width * 0.5f;
+    f32 halfHeight = preview->height * 0.5f;
+    control.control.type = 0;
+    vertices[0].x = -halfWidth;
+    vertices[0].y = -halfHeight;
+    vertices[1].x = halfWidth;
+    vertices[1].y = -halfHeight;
+    vertices[2].x = halfWidth;
+    vertices[2].y = halfHeight;
+    vertices[3].x = -halfWidth;
+    vertices[3].y = halfHeight;
+    vertices[0].z = vertices[1].z = vertices[2].z = vertices[3].z = 0;
+    CTRLSetRotation(&control.control, preview->rotation.x, preview->rotation.y, preview->rotation.z);
+    CTRLSetTranslation(&control.control, (0.5f * preview->x) * 0.5f * preview->scale,
+                       (0.35f * preview->y) * 0.5f * preview->scale, -1.5f);
+    CTRLBuildMatrix(&control.control, transform);
+    GXLoadPosMtxImm(transform, 0);
+    GXSetCurrentMtx(0);
+    C_MTXOrtho(projection, -0.175f * preview->scale, 0.175f * preview->scale,
+               0.25f * preview->scale, -0.25f * preview->scale, 1.0f, 512.0f);
+    GXSetProjection(projection, GX_ORTHOGRAPHIC);
+    GXSetCullMode(GX_CULL_BACK);
+    GXBegin(GX_QUADS, GX_VTXFMT0, 4);
+    emitPreviewQuad(vertices, &preview->frontColor);
+    GXSetCullMode(GX_CULL_FRONT);
+    GXBegin(GX_QUADS, GX_VTXFMT0, 4);
+    emitPreviewQuad(vertices, &preview->backColor);
 }
 
