+static inline void emitPreviewQuad(Vec* vertices, u32* color) {
+    s32 i;
+    for (i = 0; i < 4; i++) {
+        GXPosition3f32(vertices[i].x, vertices[i].y, vertices[i].z);
+        GXColor1u32(*color);
