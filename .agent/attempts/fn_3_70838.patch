+// Apply the velocity needed to reach the next Egg Ball bounce point.
+/* FAKEMATCH: Keep the component temporaries inside the inlined velocity update. */
+static inline void setEggBounceVelocity(f32 velocity) {
+    f32 dx;
+    f32 dy;
+    f32 distance;
+    f32 roundedVelocity;
+    g_Pitcher.ballVelocity.z = velocity;
+    g_Pitcher.framesSinceFirstEggBounce = 0;
+    roundedVelocity = g_Pitcher.ballVelocity.z;
+    dx = g_Pitcher.pitchStartingPosition_AIMaxCurve - g_Pitcher.ballCurrentPosition.x;
+    dy = g_Pitcher.eggBallBounceYHeight - g_Pitcher.ballCurrentPosition.y;
+    distance = g_Pitcher.ballCurrentPosition.z - g_Pitcher.frontOfPlateZ;
+    dx *= roundedVelocity;
+    dy *= roundedVelocity;
+    dx /= distance;
+    dy /= distance;
+    g_Pitcher.ballVelocity.x = -dx;
+    g_Pitcher.ballVelocity.y = -dy;
+}
